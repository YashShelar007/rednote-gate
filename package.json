{
  "name": "rednote-gate",
  "version": "1.1.1",
  "description": "MCP server for one throwaway RedNote (Xiaohongshu) account. Reads run directly; every write waits for a human Approve click.",
  "mcpName": "io.github.YashShelar007/rednote-gate",
  "license": "MIT",
  "author": "Yash Shelar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YashShelar007/rednote-gate.git"
  },
  "homepage": "https://github.com/YashShelar007/rednote-gate#readme",
  "bugs": {
    "url": "https://github.com/YashShelar007/rednote-gate/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rednote",
    "xiaohongshu",
    "playwright",
    "human-in-the-loop",
    "approval",
    "claude"
  ],
  "type": "module",
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "rednote-gate": "dist/cli.js"
  },
  "scripts": {
    "setup": "npm install && npm run build && node dist/cli.js setup",
    "build": "tsc",
    "start": "node dist/cli.js",
    "service": "node dist/service.js",
    "stop": "node dist/cli.js stop",
    "login": "node dist/cli.js login",
    "connect": "node dist/cli.js connect",
    "live": "node dist/cli.js live",
    "dry": "node dist/cli.js dry",
    "approve": "node dist/cli.js approve",
    "test": "tsc && node --test dist/*.test.js",
    "prepublishOnly": "npm test",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.63.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
